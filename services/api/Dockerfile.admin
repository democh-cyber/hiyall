# Hiyall admin console image: the console binary (/admin) and its built single page app (/console).
#
# Build from the REPOSITORY ROOT (the UI lives in apps/admin):
#   docker build -f services/api/Dockerfile.admin -t hiyall-admin .
# Run:       docker run --env-file admin.env -p 127.0.0.1:8081:8081 hiyall-admin
# Operators: docker run -it --env-file admin.env hiyall-admin operator-add -email EMAIL -role admin
#
# Never expose this image to the internet: see docs/security/15-admin-console.md and the deploy guide. It
# listens on loopback unless ADMIN_ADDR, ADMIN_ALLOW_REMOTE=true, ADMIN_TRUST_PROXY=true (a TLS terminating proxy
# you control) and ADMIN_ALLOWED_HOSTS are set, and it connects as the least-privilege hiyall_admin database role
# (ADMIN_DATABASE_URL, database/roles/roles.sql), never as the migration role.
#
# Base images are pinned by tag AND digest (index digests resolved on 2026-10-15): node:24.21.0-alpine3.24
# (toolchains.lock.json), golang:1.27.2-alpine3.24 (go.mod) and gcr.io/distroless/static-debian13:nonroot.
# Dependabot (docker ecosystem, /services/api) proposes new digests; when you move a tag by hand, move its digest too.

FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS ui
WORKDIR /src/apps/admin
COPY apps/admin/package.json apps/admin/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/admin/ ./
# tsc --noEmit, then a build with no inline script or style (the console's CSP forbids both).
RUN npm run build

FROM golang:1.27.2-alpine3.24@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0 GOFLAGS=-mod=readonly
WORKDIR /src/services/api
COPY services/api/go.mod services/api/go.sum ./
RUN go mod download
COPY services/api/ ./
# Stamped like the API image (see services/api/Dockerfile): the release workflow passes COMMIT and VERSION, and
# `/admin version` prints them.
ARG COMMIT=unknown
ARG VERSION=dev
RUN LDFLAGS="-s -w -X hiyall/services/api/internal/buildinfo.Commit=${COMMIT} -X hiyall/services/api/internal/buildinfo.Version=${VERSION}" \
 && go build -trimpath -buildvcs=false -ldflags="${LDFLAGS}" -o /out/admin ./cmd/admin

FROM gcr.io/distroless/static-debian13:nonroot@sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3
COPY --from=build /out/admin /admin
COPY --from=ui /src/apps/admin/dist /console
ENV ADMIN_STATIC_DIR=/console
USER nonroot:nonroot
EXPOSE 8081
# No shell, curl or wget in the image: the binary checks itself (`admin healthcheck` opens a TCP connection to
# ADMIN_ADDR, no login and no database involved).
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=3 CMD ["/admin", "healthcheck"]
ENTRYPOINT ["/admin"]
