# Every environment variable the Hiyall admin console (services/api/cmd/admin, image: services/api/Dockerfile.admin) reads.
# Copy to infrastructure/docker/admin.env (git-ignored) and fill in. Values below are placeholders; real secrets come
# from the platform's secret store (docs/deployment/10-deploy-guide.md section 11). The console is a staff tool: it must
# never be reachable from the public internet (docs/security/15-admin-console.md).
# scripts/check_env_docs.py fails when this list and the Go code disagree.
#
# Legend: [required] the console refuses to start without it; [optional] has a default or a feature switches off;
# [prod] extra rule when APP_ENV=production.

# [required] "development" or "production".
APP_ENV=production

# [required, prod] The console's own database role (hiyall_admin, database/roles/roles.sql): INSERT and SELECT on the
# audit log, and only the reads the console needs. [prod] sslmode=verify-full. Direct connection to the primary.
ADMIN_DATABASE_URL=postgresql://hiyall_admin:CHANGE-ME@db.internal:5432/hiyall?sslmode=verify-full

# [optional, not for production] Fallback when ADMIN_DATABASE_URL is unset: the console then runs as the API's role.
# [prod] refused unless ADMIN_ALLOW_SHARED_DB=true.
DATABASE_URL=
ADMIN_ALLOW_SHARED_DB=

# [required] 32 random bytes, base64 (openssl rand -base64 32). Encrypts the operators' authenticator secrets. Losing it
# means re-enrolling every operator. Or put it in a file and set ADMIN_DATA_KEY_FILE (used when ADMIN_DATA_KEY is unset).
ADMIN_DATA_KEY=
ADMIN_DATA_KEY_FILE=

# [optional] Listener address, default 127.0.0.1:8081 (loopback only). The image's HEALTHCHECK (`admin healthcheck`)
# connects to this address, so it follows the value you set.
ADMIN_ADDR=127.0.0.1:8081

# [optional] true allows a non-loopback ADMIN_ADDR, and then requires TLS in front: ADMIN_TLS_CERT + ADMIN_TLS_KEY, or
# ADMIN_TRUST_PROXY=true behind a TLS terminating proxy YOU control (the console then enforces X-Forwarded-Proto: https).
ADMIN_ALLOW_REMOTE=false
ADMIN_TRUST_PROXY=false
ADMIN_TLS_CERT=
ADMIN_TLS_KEY=

# [required in production with ADMIN_TRUST_PROXY=true] Comma separated CIDR blocks (or single addresses) of the proxy
# in front of the console. The client address (lockout bucket, audit log) is taken from X-Forwarded-For ONLY when the
# TCP peer is inside them; from any other peer the headers are ignored. Without it the peer (the proxy) is the client.
ADMIN_TRUSTED_PROXY_CIDRS=
# [optional; needs ADMIN_TRUSTED_PROXY_CIDRS] A single-address header the proxy sets and overwrites (Fly-Client-IP,
# CF-Connecting-IP). Without it the rightmost untrusted X-Forwarded-For hop is used.
ADMIN_CLIENT_IP_HEADER=

# [required unless the listener is loopback] Comma separated Host header allow-list, for example admin.<your-private-domain>.
ADMIN_ALLOWED_HOSTS=

# [optional] Directory of the built console UI. The image sets /console; a source checkout uses apps/admin/dist.
ADMIN_STATIC_DIR=/console

# [optional, read by `admin schedule-deletion` only] The e-mail address of the ACTIVE ADMINISTRATOR who runs the command, used when -operator
# is not given. The support-driven deletion is audited under this address, never under a shell user (cli:root); the command refuses
# to run without one. Set it in the environment of the person at the terminal, not in the console's service environment.
ADMIN_OPERATOR_EMAIL=

# [optional] Photo preview for reported content. Without ADMIN_MEDIA_ENDPOINT the console shows text only.
# Endpoint without scheme (<ACCOUNT_ID>.r2.cloudflarestorage.com). Use a READ-ONLY token scoped to the media bucket,
# never the API's write token. [prod] ADMIN_MEDIA_SECURE must be true.
ADMIN_MEDIA_ENDPOINT=
ADMIN_MEDIA_BUCKET=
ADMIN_MEDIA_REGION=
ADMIN_MEDIA_ACCESS_KEY=
ADMIN_MEDIA_SECRET_KEY=
ADMIN_MEDIA_SECURE=true

# [prod: required when ADMIN_MEDIA_ENDPOINT is set, unless EVIDENCE_ALLOW_SHARED_BUCKET=true] The evidence bucket that
# holds quarantined originals, apart from the media bucket (the API's EVIDENCE_BUCKET). A READ-ONLY token: the case
# viewer shows a blurred copy made on the server, and the original only after the audited reveal. Without
# ADMIN_EVIDENCE_ENDPOINT, cases are read from the media bucket above (development only). [prod] ADMIN_EVIDENCE_SECURE=true.
ADMIN_EVIDENCE_ENDPOINT=
ADMIN_EVIDENCE_BUCKET=hiyall-evidence
ADMIN_EVIDENCE_REGION=
ADMIN_EVIDENCE_ACCESS_KEY=
ADMIN_EVIDENCE_SECRET_KEY=
ADMIN_EVIDENCE_SECURE=true
# [optional] A DIFFERENT credential for the same bucket that may delete (it must not equal the read-only key; both of
# the pair or neither). Only the hold purge job uses it (hourly inside `admin serve`, or `admin purge-holds`), never a
# request handler. Without it released evidence is never removed.
ADMIN_EVIDENCE_DELETE_ACCESS_KEY=
ADMIN_EVIDENCE_DELETE_SECRET_KEY=
# [prod] Set true (here and in the API's environment) to accept quarantined originals sitting in the media bucket.
# Read by the console as EVIDENCE_ALLOW_SHARED_BUCKET, the same name the API uses.
EVIDENCE_ALLOW_SHARED_BUCKET=
