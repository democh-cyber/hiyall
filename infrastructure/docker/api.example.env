# Every environment variable the Hiyall API (cmd/api) and the migration runner (cmd/migrate) read.
# Copy to infrastructure/docker/api.env (git-ignored) and fill in.
# Values below are placeholders. Never commit real secrets; in production they come from the platform's
# secret store (docs/deployment/10-deploy-guide.md).
#
# Legend: [required] the API refuses to start without it; [optional] has a default or a feature switches
# off; [prod] extra rule when APP_ENV=production.

# ---- Core ---------------------------------------------------------------------------------------

# [required] "development" or "production". Production enforces HTTPS issuer, sslmode=verify-full on
# the database, secure media endpoints and a WEB_ORIGIN that is an https origin.
APP_ENV=production

# [required] PostgreSQL 16 connection string. [prod] must carry sslmode=verify-full. Point it at the
# primary directly (or a session-mode pooler): maintenance leader election uses a session-level
# advisory lock, which a transaction-mode pooler (PgBouncer port 6432 / Supabase port 6543) breaks.
DATABASE_URL=postgresql://hiyall_api:CHANGE-ME@db.internal:5432/hiyall?sslmode=verify-full

# [prod] The API's role is hiyall_api, created once by database/roles/roles.sql (docs/deployment/10-deploy-guide.md,
# section 11): it can read and write member data and cannot reach the operator tables, case evidence or the audit
# log. A production start REFUSES a role that is a superuser, owns tables, can read operators/operator_sessions/
# operator_login_attempts/operator_audit/content_cases or can change operator_audit. Set true only to accept a
# single-role deployment knowingly; every start then logs the reasons as errors. `api check-config -db` shows them.
DB_ALLOW_OWNER_ROLE=

# [optional] Address the API listens on. Default 127.0.0.1:8080. The container image sets 0.0.0.0:8080.
# Also read by `api healthcheck`, so the check follows the port you choose.
LISTEN_ADDR=0.0.0.0:8080

# [optional] The one browser origin allowed to call the API with CORS (the web build), for example
# https://app.example.com . Native apps send no Origin and need nothing. [prod] must be an https origin.
WEB_ORIGIN=

# [optional, default true] true keeps minors and adults from seeing or reaching each other.
# [prod] false is refused: the teens document promises the separation unconditionally. In development it
# restores block-only behaviour (with a warning).
AGE_BAND_ISOLATION=true

# ---- Sign-in (exactly one of the first two groups, unless ENABLE_DEV_AUTH) -----------------------

# [required unless OIDC_* is set] Firebase project id. Issuer and audience are derived from it.
# 4-64 lowercase letters, digits or hyphens. Cannot be combined with a different OIDC_ISSUER/AUDIENCE.
FIREBASE_PROJECT_ID=your-firebase-project-id

# [alternative to FIREBASE_PROJECT_ID] Generic OIDC. Both required together. [prod] issuer must be https.
OIDC_ISSUER=
OIDC_AUDIENCE=

# [development only] Fixture accounts and POST /dev/session. Requires APP_ENV=development and a loopback
# LISTEN_ADDR; the API refuses to start otherwise. Never set in production.
ENABLE_DEV_AUTH=

# [prod, required with Firebase sign-in] Path to a Firebase service-account JSON that deletes Firebase users
# when an account is purged (account deletion); the privacy policy promises the sign-in record goes too, so
# production refuses to start when it is unset or unreadable. Requires FIREBASE_PROJECT_ID. In development
# without it the Firebase user is left in place and a warning is logged. Mount it as a secret file; never
# bake it into the image. (Documented once more under "Account deletion" below; it is one variable.)
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- Social media bucket (profile photos, story images) ------------------------------------------

# [optional] S3-compatible endpoint, without scheme, e.g. <ACCOUNT_ID>.r2.cloudflarestorage.com.
# Empty means photo uploads answer 503. When set, access key and secret are required.
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
# [optional, default hiyall-media]
MEDIA_BUCKET=hiyall-media
# [optional, default us-east-1] R2 uses "auto".
MEDIA_REGION=auto
# [optional, default false] true for https endpoints. [prod] must be true when MEDIA_ENDPOINT is set.
MEDIA_SECURE=true

# ---- Encrypted chat attachments bucket (a different bucket and a bucket-scoped token) ------------

# [optional] Same shape as MEDIA_*. Empty means sending photos in chats answers 503
# CHAT_MEDIA_UNAVAILABLE. Must not be the same endpoint+bucket as the social bucket.
CHAT_MEDIA_ENDPOINT=
CHAT_MEDIA_ACCESS_KEY=
CHAT_MEDIA_SECRET_KEY=
# [optional, default hiyall-chat]
CHAT_MEDIA_BUCKET=hiyall-chat
# [optional, default us-east-1]
CHAT_MEDIA_REGION=auto
# [optional, default false] [prod] must be true when CHAT_MEDIA_ENDPOINT is set.
CHAT_MEDIA_SECURE=true

# ---- Push notifications ----------------------------------------------------------------------------

# [optional] Path to the Firebase service-account JSON used to send FCM pushes (Android and iOS via
# FCM). Empty: pushes are only logged. [prod] when set it must be readable and a valid service-account key,
# or the API refuses to start (a broken file would otherwise silently turn pushes into log lines). FCM's
# SENDER_ID_MISMATCH (this key and the app belong to different Firebase projects) is treated as a
# configuration error, not a dead token: tokens are kept, hiyall_push_config_errors_total counts it, alert
# on any. Mount it as a secret file.
FCM_SERVICE_ACCOUNT_FILE=
# [optional] FCM project; defaults to FIREBASE_PROJECT_ID.
FCM_PROJECT_ID=

# ---- Account deletion -------------------------------------------------------------------------------

# [optional] Path to a Firebase service-account JSON (role: Firebase Authentication Admin) that lets the
# account purge delete the person's Firebase user as its last step. Needs FIREBASE_PROJECT_ID. Empty: the
# purge still removes everything in Hiyall and logs that the Firebase user was left in place. Mount it as
# a secret file. See docs/api/22-account-deletion-and-export.md.
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- Upload scanning (docs/security/16-csam-and-illegal-content.md) ------------------------------------

# [prod: at least one scanner, or SCAN_ALLOW_NONE=true, when MEDIA_ENDPOINT is set] Photos that are not
# end-to-end encrypted (avatars, posts, stories) are scanned after processing and before they can be shown.
# A flag or a match is quarantined under hold/ in the media bucket, opens a case in the admin console and (a
# match) suspends the uploader. Nothing is sent anywhere automatically.
# Path to YOUR hash list: sha256:<hex> and phash:<16 hex> lines (see the runbook). Never commit one.
SCAN_HASHLIST_FILE=
# A hosted scanning service (PhotoDNA-style). Both together; https only in production. The adapter in
# internal/media/scan.go is a skeleton you complete for the vendor you are onboarded with.
SCAN_PROVIDER_URL=
SCAN_PROVIDER_KEY_FILE=
# [prod] true lets production run with NO scanner. Logs a loud error at every start. Do not use with real members.
SCAN_ALLOW_NONE=

# ---- Sign in with Apple token revocation (App Store guideline 5.1.1(v)) -----------------------------------

# [prod: required when APPLE_SIGN_IN_ENABLED=true] Deleting an account revokes the person's Apple authorization:
# the app signs in with Apple again during deletion and sends the one-time code, which the API trades for a
# refresh token and revokes at appleid.apple.com. All four together; empty is a no-op with a warning.
APPLE_SIGN_IN_ENABLED=
# Apple developer Team ID, the Key ID of a "Sign in with Apple" key, the Client ID (the app's bundle id; a
# Services ID for the web) and the path to the downloaded AuthKey_<KeyID>.p8 (mount as a secret file).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY_FILE=

# ---- Operations ------------------------------------------------------------------------------------

# [optional] Prometheus metrics listener, never the public one. Unset: 127.0.0.1:9090. Set to empty to
# turn metrics off. Any non-loopback address (0.0.0.0:9090, :9090, a private IP) requires METRICS_TOKEN,
# and the port must stay on a private network.
METRICS_ADDR=127.0.0.1:9090
# [required when METRICS_ADDR is not loopback] Bearer token for /metrics, at least 16 characters:
#   openssl rand -hex 24
METRICS_TOKEN=

# [optional, default memory; prod: must be postgres] "memory": per-account rate limits are counted per API
# node (N nodes allow N times the limit) and evict their oldest keys past a cap. "postgres": counted once for
# all nodes in the rate_limits table (migration 0030), one extra indexed write per limited request.
# Production refuses to start with anything else.
RATE_LIMIT_BACKEND=postgres

# [optional] Directory with the *.sql migrations. The image sets /migrations. Used by /migrate and by
# /readyz, which reports "not ready" while the database lacks a migration this release ships. Unset in
# a source checkout it falls back to ../../database/migrations; if neither exists the readiness schema
# check is off (logged).
MIGRATIONS_DIR=/migrations

# [optional] Error reporting. With SENTRY_DSN set, handler panics and unexpected 500s are sent to Sentry
# through internal/errreport: a scrubbed message, the route pattern and the request id, never the URL,
# headers or body. Unset: errors are only logged (a warning in production). SENTRY_ENVIRONMENT defaults to
# APP_ENV; SENTRY_RELEASE is free text such as the git sha. The DSN is not echoed anywhere.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# [optional, default false] Allow creating event and moment spaces. Off for V1: only communities can be
# created (403 FEATURE_DISABLED otherwise); existing events and moments stay readable. The app has the
# matching ENABLE_EVENTS dart-define.
SPACES_EVENTS_ENABLED=false

# ---- Behind a proxy: the client's address (audit S1) ----------------------------------------------------

# [optional; prod: required when BEHIND_PROXY=true] Comma-separated CIDR blocks (or single addresses) of the
# reverse proxies in front of the API. Only a request whose direct TCP peer is inside one of them has its
# forwarded headers read; everyone else is keyed by their own address, so a client cannot choose its rate-limit
# bucket by sending headers. Behind Fly.io or Caddy without this, every client shares one bucket (the proxy's).
# Fly: the proxy reaches the app from its private 6PN network; check the CIDR with `fly ssh console -C
# "ip -6 addr"` and the proxy's source in the first requests' logs; Docker/Caddy on one host: the bridge
# network, e.g. 172.16.0.0/12. Examples:  TRUSTED_PROXY_CIDRS=172.16.0.0/12,fdaa::/16
TRUSTED_PROXY_CIDRS=
# [optional] A single-address header the trusted proxy sets and overwrites, such as Fly-Client-IP or
# CF-Connecting-IP. Used when the peer is trusted and the header holds a valid address; otherwise the rightmost
# untrusted X-Forwarded-For hop is used. Needs TRUSTED_PROXY_CIDRS.
CLIENT_IP_HEADER=
# [optional, default false] Say so when the API is only ever reached through a proxy. [prod] true without
# TRUSTED_PROXY_CIDRS stops the start: it would put every client in one bucket. The chosen mode is logged
# once at startup ("client address: ...").
BEHIND_PROXY=true

# ---- Firebase App Check (docs/deployment/10-deploy-guide.md, "App Check") -------------------------------

# [optional, default false] false: nothing is checked (the app does not send tokens yet). log: tokens are verified
# and missing or invalid ones are only counted in hiyall_app_check_total, never refused. true: a request without a valid
# X-Firebase-AppCheck token answers 401 APP_CHECK_REQUIRED (probes, the legal documents and development login are
# exempt). Set log first, then true after an app release that sends tokens. log and true need FIREBASE_PROJECT_NUMBER.
APP_CHECK_ENFORCE=false
# [required for log and true] The NUMERIC Firebase project number (Firebase console > Project settings), not the project id.
FIREBASE_PROJECT_NUMBER=

# ---- Client address, direct listener and debugging (audit API-1) --------------------------------------------

# [optional, default false; prod: exactly one of BEHIND_PROXY=true with TRUSTED_PROXY_CIDRS, or DIRECT_LISTENER=true] Say so
# when clients reach this process directly with no proxy in front: the peer address is then the client. It cannot be
# combined with BEHIND_PROXY or TRUSTED_PROXY_CIDRS.
DIRECT_LISTENER=
# [optional, default false] Log the peer and the forwarding headers of the first 20 requests, so the proxy's address
# can be read from the log. Temporary: unset it once TRUSTED_PROXY_CIDRS is set.
DEBUG_LOG_PEER=

# ---- Nearby, photo processing and exports (audit API-4, API-5, API-9) -------------------------------------------

# [prod, required] Base64 of 32 random bytes (openssl rand -base64 32). Keys the stable secret offset added to a shared
# location before it is rounded and stored. Changing it moves every member's offset once: never rotate it casually.
NEARBY_OFFSET_KEY=
# [optional] The previous key, accepted so a rotation can be written down in the environment; needs NEARBY_OFFSET_KEY.
NEARBY_OFFSET_KEY_PREVIOUS=
# [optional, default 2, 1 to 16] How many photo uploads this node decodes and re-encodes at once; the others wait, then
# get 503 with Retry-After (hiyall_media_busy_total). Decode memory is bounded by 12 megapixels times this.
MEDIA_PROCESS_SLOTS=2
# [optional, default 3, 1 to 50] How many data exports this node builds at once; a further one gets 503 with Retry-After
# and keeps its daily claim.
EXPORT_CONCURRENCY=3

# ---- Evidence bucket for quarantined photos (docs/security/16-csam-and-illegal-content.md) ------------------

# [prod: required when MEDIA_ENDPOINT is set, unless EVIDENCE_ALLOW_SHARED_BUCKET=true] A bucket of its own for the
# originals of quarantined photos. The API's token there must be WRITE-ONLY (no read, no delete). It must not be the social
# media bucket or the chat bucket. Created by you, like the others.
EVIDENCE_BUCKET=
# [optional] Default to the media bucket's endpoint, region and secure setting. [prod] EVIDENCE_SECURE must be true.
EVIDENCE_ENDPOINT=
EVIDENCE_REGION=
EVIDENCE_SECURE=
# [required with EVIDENCE_BUCKET] The write-only token for the evidence bucket.
EVIDENCE_ACCESS_KEY=
EVIDENCE_SECRET_KEY=
# [optional, default false] Keep quarantined originals in the media bucket under hold/ instead, where the API's own
# token could delete them. Production refuses to start without EVIDENCE_BUCKET unless this is true. Not for real users.
EVIDENCE_ALLOW_SHARED_BUCKET=
# [optional, default 365, 30 to 3650] How many days the evidence of a NEW quarantine case is held, pending counsel's advice
# (the legal texts say `[COUNSEL: evidence retention period, default currently 365 days]`). Existing cases keep the
# hold_until they have.
EVIDENCE_RETENTION_DAYS=365

# ---- Cursors (audit S5) ---------------------------------------------------------------------------------

# [prod, required] Base64 of 32 random bytes (openssl rand -base64 32) that signs list cursors (feed and
# member lists, search, Nearby, sessions). It must be the same on every node and survive deploys; a random
# per-process key makes cursors fail across nodes and after every release. Development without it uses a
# random key per process.
CURSOR_KEY=
# [optional] The previous key, kept for verification only while you rotate: set CURSOR_KEY to a new value,
# CURSOR_KEY_PREVIOUS to the old one, deploy, and remove the previous key after 15 minutes (cursors live that long).
CURSOR_KEY_PREVIOUS=

# ---- Database pool and timeouts (audit S4, D4) ------------------------------------------------------------

# [optional, default 20] Connections in each node's request pool (2-500), plus a small separate pool of 4 for
# the background jobs and one each for realtime LISTEN and the leader lock. A pool_max_conns in DATABASE_URL
# wins when present. Sum over nodes must stay under the database's max_connections.
DB_MAX_CONNS=20
# [optional] Limits set on every request connection, as Go durations; 0 turns one off. Defaults: a statement
# 5s, a lock wait 3s, a session idle inside an open transaction 15s. The maintenance jobs and the account
# export run with longer limits of their own (2 min, 10 s, 2 min).
DB_STATEMENT_TIMEOUT=5s
DB_LOCK_TIMEOUT=3s
DB_IDLE_IN_TRANSACTION_TIMEOUT=15s

# ---- Migration runner (cmd/migrate, the release command) ---------------------------------------------------

# [optional] Overall deadline for one run (default 10m), how long one statement may wait for a lock before
# the file is rolled back and retried (default 5s, up to 8 retries), and the per-statement limit of a
# transactional file (default 5m, 0 = off). Each file runs in its own transaction. A file whose first line is
# "-- hiyall:no-transaction" runs statement by statement outside a transaction, for CREATE INDEX CONCURRENTLY.
MIGRATE_DEADLINE=10m
MIGRATE_LOCK_TIMEOUT=5s
MIGRATE_STATEMENT_TIMEOUT=5m

# [optional] The release step's own connection string, used by /migrate instead of DATABASE_URL: the table owner
# hiyall_migrate, while DATABASE_URL (shared with the API) names hiyall_api. Unset: DATABASE_URL.
MIGRATE_DATABASE_URL=
# [optional, default false; true in production] After the migrations apply database/roles/grants.sql, as the same
# role, in one transaction (privilege refresh for new tables and views). Fails the release step if it cannot.
MIGRATE_RUN_GRANTS=
# [optional] Path of grants.sql. Default <MIGRATIONS_DIR>/../roles/grants.sql, which is /roles/grants.sql in the image.
MIGRATE_GRANTS_FILE=

# ---- Older app versions (audit O6) ------------------------------------------------------------------------

# [optional, default off] The oldest app version still served per platform, as a semantic version. A request
# from that platform (X-Client-Platform: android, ios or web) with an older X-Client-Version, or none, gets
# 426 with code UPGRADE_REQUIRED and the app shows a blocking "update" screen. Health probes, legal
# documents and sign-out are exempt. Raise it to retire a broken build; an empty value turns that platform's
# check off.
MIN_CLIENT_VERSION_ANDROID=
MIN_CLIENT_VERSION_IOS=
MIN_CLIENT_VERSION_WEB=

# ---- Logs, memory and build stamp (audit O10, S11) ---------------------------------------------------------

# [optional] "json" or "text". Default json in production, text in development. One JSON object per line:
# the request log carries the method, the route pattern (never the raw path or query), status and timing.
LOG_FORMAT=json
# [recommended, not read by the API: it is a Go runtime variable] A soft memory limit, about 80% of the
# machine's memory (400MiB on a 512 MB machine). Photo processing decodes up to 20 megapixels, four at a
# time, and the limit makes the garbage collector work harder before the machine is killed for memory.
# Set it in the platform's env next to this file (fly.toml [env]).
GOMEMLIMIT=400MiB
# The commit and version are not environment variables: they are stamped into the binary at build time
# (docker build --build-arg COMMIT=... --build-arg VERSION=...) and appear in the startup log and as
# hiyall_build_info{version,commit}.
