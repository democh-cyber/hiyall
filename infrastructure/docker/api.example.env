# Every environment variable the Hiyall API (cmd/api) and the migration runner (cmd/migrate) read.
# Copy to infrastructure/docker/api.env (git-ignored) and fill in.
# Values below are placeholders. Never commit real secrets; in production they come from the platform's
# secret store (docs/deployment/10-deploy-guide.md).
#
# Legend: [required] the API refuses to start without it; [optional] has a default or a feature switches
# off; [prod] extra rule when APP_ENV=production.

# ---- Core ---------------------------------------------------------------------------------------

# [required] "development" or "production". Production enforces HTTPS issuer, sslmode=verify-full on
# the database, secure media endpoints and a WEB_ORIGIN that is an https origin.
APP_ENV=production

# [required] PostgreSQL 16 connection string. [prod] must carry sslmode=verify-full. Point it at the
# primary directly (or a session-mode pooler): maintenance leader election uses a session-level
# advisory lock, which a transaction-mode pooler (PgBouncer port 6432 / Supabase port 6543) breaks.
DATABASE_URL=postgresql://hiyall:CHANGE-ME@db.internal:5432/hiyall?sslmode=verify-full

# [optional] Address the API listens on. Default 127.0.0.1:8080. The container image sets 0.0.0.0:8080.
# Also read by `api healthcheck`, so the check follows the port you choose.
LISTEN_ADDR=0.0.0.0:8080

# [optional] The one browser origin allowed to call the API with CORS (the web build), for example
# https://app.example.com . Native apps send no Origin and need nothing. [prod] must be an https origin.
WEB_ORIGIN=

# [optional, default true] true keeps minors and adults from seeing or reaching each other.
# Changing it is a policy decision (docs/security); leave it true.
AGE_BAND_ISOLATION=true

# ---- Sign-in (exactly one of the first two groups, unless ENABLE_DEV_AUTH) -----------------------

# [required unless OIDC_* is set] Firebase project id. Issuer and audience are derived from it.
# 4-64 lowercase letters, digits or hyphens. Cannot be combined with a different OIDC_ISSUER/AUDIENCE.
FIREBASE_PROJECT_ID=your-firebase-project-id

# [alternative to FIREBASE_PROJECT_ID] Generic OIDC. Both required together. [prod] issuer must be https.
OIDC_ISSUER=
OIDC_AUDIENCE=

# [development only] Fixture accounts and POST /dev/session. Requires APP_ENV=development and a loopback
# LISTEN_ADDR; the API refuses to start otherwise. Never set in production.
ENABLE_DEV_AUTH=

# [optional] Path to a Firebase service-account JSON that may delete Firebase users when an account is
# purged (account deletion). Requires FIREBASE_PROJECT_ID. Without it the Firebase user is left in place
# and a warning is logged. Mount it as a secret file; never bake it into the image.
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- Social media bucket (profile photos, story images) ------------------------------------------

# [optional] S3-compatible endpoint, without scheme, e.g. <ACCOUNT_ID>.r2.cloudflarestorage.com.
# Empty means photo uploads answer 503. When set, access key and secret are required.
MEDIA_ENDPOINT=
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
# [optional, default hiyall-media]
MEDIA_BUCKET=hiyall-media
# [optional, default us-east-1] R2 uses "auto".
MEDIA_REGION=auto
# [optional, default false] true for https endpoints. [prod] must be true when MEDIA_ENDPOINT is set.
MEDIA_SECURE=true

# ---- Encrypted chat attachments bucket (a different bucket and a bucket-scoped token) ------------

# [optional] Same shape as MEDIA_*. Empty means sending photos in chats answers 503
# CHAT_MEDIA_UNAVAILABLE. Must not be the same endpoint+bucket as the social bucket.
CHAT_MEDIA_ENDPOINT=
CHAT_MEDIA_ACCESS_KEY=
CHAT_MEDIA_SECRET_KEY=
# [optional, default hiyall-chat]
CHAT_MEDIA_BUCKET=hiyall-chat
# [optional, default us-east-1]
CHAT_MEDIA_REGION=auto
# [optional, default false] [prod] must be true when CHAT_MEDIA_ENDPOINT is set.
CHAT_MEDIA_SECURE=true

# ---- Push notifications ----------------------------------------------------------------------------

# [optional] Path to the Firebase service-account JSON used to send FCM pushes (Android and iOS via
# FCM). Empty: pushes are only logged. Mount it as a secret file.
FCM_SERVICE_ACCOUNT_FILE=
# [optional] FCM project; defaults to FIREBASE_PROJECT_ID.
FCM_PROJECT_ID=

# ---- Account deletion -------------------------------------------------------------------------------

# [optional] Path to a Firebase service-account JSON (role: Firebase Authentication Admin) that lets the
# account purge delete the person's Firebase user as its last step. Needs FIREBASE_PROJECT_ID. Empty: the
# purge still removes everything in Hiyall and logs that the Firebase user was left in place. Mount it as
# a secret file. See docs/api/22-account-deletion-and-export.md.
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---- Operations ------------------------------------------------------------------------------------

# [optional] Prometheus metrics listener, never the public one. Unset: 127.0.0.1:9090. Set to empty to
# turn metrics off. Any non-loopback address (0.0.0.0:9090, :9090, a private IP) requires METRICS_TOKEN,
# and the port must stay on a private network.
METRICS_ADDR=127.0.0.1:9090
# [required when METRICS_ADDR is not loopback] Bearer token for /metrics, at least 16 characters:
#   openssl rand -hex 24
METRICS_TOKEN=

# [optional, default memory] "memory": per-account rate limits are counted per API node (N nodes allow
# N times the limit). "postgres": counted once for all nodes in the rate_limits table (migration 0030),
# one extra indexed write per limited request. Use postgres with more than one API node.
RATE_LIMIT_BACKEND=memory

# [optional] Directory with the *.sql migrations. The image sets /migrations. Used by /migrate and by
# /readyz, which reports "not ready" while the database lacks a migration this release ships. Unset in
# a source checkout it falls back to ../../database/migrations; if neither exists the readiness schema
# check is off (logged).
MIGRATIONS_DIR=/migrations
