<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen (SplashScreen API): brand background, the star on a lime disc.
         Replaces the OS default of the launcher icon on a plain background. The pre-12 splash is
         drawable/launch_background.xml (kept in sync: same background colours). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
