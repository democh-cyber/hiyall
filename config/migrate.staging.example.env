# The release step (/migrate) for STAGING. NOT an API overlay: see config/migrate.production.example.env for why the running API
# must never hold MIGRATE_DATABASE_URL (the table owner, hiyall_migrate). Run it from your shell or a one-off machine.
MIGRATE_DATABASE_URL=postgresql://hiyall_migrate:CHANGE-ME@<staging-db-host>:5432/hiyall_staging?sslmode=verify-full
MIGRATE_RUN_GRANTS=true
