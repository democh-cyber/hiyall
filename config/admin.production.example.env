# Production overlay for infrastructure/docker/admin.example.env (the full list, with every rule): only the values that
# differ per environment. All placeholders; real values go in the platform's secret store, never here. The same
# names are read by the admin console image (services/api/Dockerfile.admin).
APP_ENV=production
ADMIN_DATABASE_URL=postgresql://hiyall_admin:CHANGE-ME@<production-db-host>:5432/hiyall?sslmode=verify-full
# ADMIN_DATA_KEY is a secret (openssl rand -base64 32): set it with the platform's secret command, or mount a file and set
# ADMIN_DATA_KEY_FILE. Never commit it.
ADMIN_DATA_KEY_FILE=/secrets/admin-data-key
ADMIN_ADDR=0.0.0.0:8081
ADMIN_ALLOW_REMOTE=true
ADMIN_TRUST_PROXY=true
# The proxy's addresses (production refuses ADMIN_TRUST_PROXY=true without them): only its X-Forwarded-For is believed.
ADMIN_TRUSTED_PROXY_CIDRS=<proxy CIDRs>
ADMIN_CLIENT_IP_HEADER=
ADMIN_ALLOWED_HOSTS=admin.<your-private-domain>
ADMIN_STATIC_DIR=/console
# The administrator who runs `admin schedule-deletion` (or pass -operator): the deletion is audited under this address. Set it in the
# environment of the person at the terminal, not in the console service.
ADMIN_OPERATOR_EMAIL=
# Read-only token for the PRODUCTION media bucket (a new token, not the API's):
ADMIN_MEDIA_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
ADMIN_MEDIA_BUCKET=hiyall-prod
ADMIN_MEDIA_REGION=auto
ADMIN_MEDIA_ACCESS_KEY=
ADMIN_MEDIA_SECRET_KEY=
ADMIN_MEDIA_SECURE=true
# ADMIN_TLS_CERT / ADMIN_TLS_KEY: only when the console terminates TLS itself instead of ADMIN_TRUST_PROXY.
ADMIN_TLS_CERT=
ADMIN_TLS_KEY=
ADMIN_ALLOW_SHARED_DB=
DATABASE_URL=
ADMIN_DATA_KEY=
# Evidence bucket for quarantined originals: a read-only token (a new one), and a separate delete credential held
# only by the hold purge job (docs/security/16-csam-and-illegal-content.md section 9).
ADMIN_EVIDENCE_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
ADMIN_EVIDENCE_BUCKET=hiyall-evidence-prod
ADMIN_EVIDENCE_REGION=auto
ADMIN_EVIDENCE_ACCESS_KEY=
ADMIN_EVIDENCE_SECRET_KEY=
ADMIN_EVIDENCE_SECURE=true
ADMIN_EVIDENCE_DELETE_ACCESS_KEY=
ADMIN_EVIDENCE_DELETE_SECRET_KEY=
