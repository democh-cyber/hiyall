# Encrypted chat photos for local development: a SECOND Cloudflare R2 bucket, never the social one.
# Copy to config/chat-media.local.env (git-ignored) and fill in the three blanks.
#
# Cloudflare dashboard > R2:
#   - Create the bucket "hiyall-chat" (the API never creates it).
#   - Account ID: R2 overview page, right-hand side.
#   - Create an API token: "Manage R2 API tokens" > Create API token >
#     permission "Object Read & Write", limited to the hiyall-chat bucket ONLY (not the social bucket).
#     It shows an Access Key ID and a Secret Access Key once; copy both here.
#   - Bucket settings > Object lifecycle rules: delete objects 45 days after upload (safety net behind
#     the API's own 30-day retention). Everything in this bucket is ciphertext the server cannot read.
CHAT_MEDIA_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
CHAT_MEDIA_BUCKET=hiyall-chat
CHAT_MEDIA_ACCESS_KEY=
CHAT_MEDIA_SECRET_KEY=
# R2 has a single region called "auto" and is always https.
CHAT_MEDIA_REGION=auto
CHAT_MEDIA_SECURE=true
