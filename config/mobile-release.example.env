# Inputs for scripts/build-release.sh and the release workflow, one file per environment (copy to
# config/mobile-release.<env>.local.env (git-ignored), or set the
# same names as GitHub environment variables/secrets). No value here is real.
API_BASE_URL=https://api.staging.<your-domain>
FIREBASE_PROJECT_ID=hiyall-staging
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
# Secrets in CI (the Firebase web API key is not a secret, but is kept with the other build inputs):
FIREBASE_API_KEY=
SENTRY_DSN=
# Added for the in-app Help & Safety page, versions and the Update screen (all read by scripts/build-release.sh):
SUPPORT_EMAIL=
SAFETY_EMAIL=
PRIVACY_EMAIL=
APP_STORE_URL=
PLAY_STORE_URL=
# APP_VERSION defaults to the v-tag (or pubspec.yaml); APP_BUILD_NUMBER to the CI run number.
APP_VERSION=
APP_BUILD_NUMBER=
# FIREBASE_WEB_APP_ID and FIREBASE_AUTH_DOMAIN are needed for the web build only.
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=
# Web build only: the public https address of the web build, ending in "/" (canonical and Open Graph tags).
WEB_CANONICAL_URL=
