# Production overlay for infrastructure/docker/api.example.env: only the values that differ per environment.
# Everything is a placeholder; real values go in the platform's secret store, never here.
APP_ENV=production
# The API runs as the least-privilege role hiyall_api (database/roles/roles.sql, once). A production start refuses a
# superuser, the owner of the tables, or any role that can read the operator tables (DB_ALLOW_OWNER_ROLE=true accepts it).
DATABASE_URL=postgresql://hiyall_api:CHANGE-ME@<production-db-host>:5432/hiyall?sslmode=verify-full
# The release step (/migrate) runs as the table owner hiyall_migrate and applies database/roles/grants.sql after the migrations.
MIGRATE_DATABASE_URL=postgresql://hiyall_migrate:CHANGE-ME@<production-db-host>:5432/hiyall?sslmode=verify-full
MIGRATE_RUN_GRANTS=true
# A NEW production Firebase project. Never the development project listed in config/environments.json:
# scripts/release-preflight.sh fails when this equals a development value.
FIREBASE_PROJECT_ID=<production-firebase-project-id>
WEB_ORIGIN=https://app.<your-domain>
MEDIA_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_BUCKET=hiyall-prod
CHAT_MEDIA_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
CHAT_MEDIA_BUCKET=hiyall-chat-prod
# Tokens limited to these two buckets only, created new for production (not the development tokens).
# Production start checks (the API refuses to start without these): a Firebase service account for account
# deletion, the shared rate-limit backend, a cursor key, and the proxy addresses when behind one.
FIREBASE_SERVICE_ACCOUNT_FILE=/secrets/firebase-admin.json
RATE_LIMIT_BACKEND=postgres
BEHIND_PROXY=true
TRUSTED_PROXY_CIDRS=<the proxy's CIDR blocks, see infrastructure/docker/api.example.env>
CLIENT_IP_HEADER=Fly-Client-IP
# CURSOR_KEY (openssl rand -base64 32) is a secret: set it with the platform's secret command, the same
# value on every node. GOMEMLIMIT is about 80% of the machine's memory (400MiB on 512 MB).
GOMEMLIMIT=400MiB
# Firebase App Check (docs/deployment/10-deploy-guide.md, "App Check"): off until it is set up in the Firebase console and the
# app sends tokens. Set log first (missing and invalid tokens are only counted in hiyall_app_check_total), then true.
# FIREBASE_PROJECT_NUMBER is the numeric project number (Project settings), not the project id.
# APP_CHECK_ENFORCE=true   (false until App Check is set up; see the guide)
APP_CHECK_ENFORCE=false
FIREBASE_PROJECT_NUMBER=
# Release requirements: `api check-config -release` (run by scripts/release-preflight.sh, gate d) refuses a V1 release
# until these are set. Secret values stay in the platform's secret store; for the local preflight copy this file to
# config/api.production.env (git-ignored) and put the key files under config/secrets/ (a path such as
# /secrets/fcm.json is looked up there).
# FCM_SERVICE_ACCOUNT_FILE=/secrets/fcm.json
# SENTRY_DSN=<server project DSN>
# MIN_CLIENT_VERSION_ANDROID=1.0.0
# MIN_CLIENT_VERSION_IOS=1.0.0
# APPLE_SIGN_IN_ENABLED=true
# APPLE_TEAM_ID=<10-character Apple team id>
# APPLE_KEY_ID=<key id of the Sign in with Apple .p8>
# APPLE_CLIENT_ID=app.hiyall.hiyall
# APPLE_PRIVATE_KEY_FILE=/secrets/apple-signin.p8
# Photo upload scanning (one of): SCAN_HASHLIST_FILE=/secrets/hashes.txt, or SCAN_PROVIDER_URL + SCAN_PROVIDER_KEY_FILE.
# Evidence bucket for quarantined photos (production refuses to start without it, unless EVIDENCE_ALLOW_SHARED_BUCKET=true):
# a bucket of its own, with an API token that can WRITE but not read or delete. EVIDENCE_ACCESS_KEY / EVIDENCE_SECRET_KEY are secrets.
EVIDENCE_BUCKET=hiyall-evidence-prod
EVIDENCE_SECURE=true
# EVIDENCE_RETENTION_DAYS=365   (pending counsel; the legal texts carry a [COUNSEL: ...] placeholder)
# NEARBY_OFFSET_KEY (openssl rand -base64 32) is required in production: a secret, set with the platform's secret command.
# Say how clients reach the API: BEHIND_PROXY=true with TRUSTED_PROXY_CIDRS above, or DIRECT_LISTENER=true (exactly one).
