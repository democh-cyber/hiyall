# The release step (/migrate, in the API image) for PRODUCTION. NOT an API overlay: the running API must never hold these.
# MIGRATE_DATABASE_URL is the table OWNER (hiyall_migrate); an API process that held it would defeat the restricted hiyall_api
# role. It lives only where the migration runs: the GitHub environment `production` (secret PRODUCTION_MIGRATE_DATABASE_URL,
# passed to /migrate as MIGRATE_DATABASE_URL by the release workflow's migrate-production job), or your own shell for a one-off run:
#   docker run --rm --env-file config/migrate.production.env --entrypoint /migrate <image>@<digest>
# Copy to config/migrate.production.env (git-ignored: *.env under config is not committed) and fill it. Never a Fly/app secret.
MIGRATE_DATABASE_URL=postgresql://hiyall_migrate:CHANGE-ME@<production-db-host>:5432/hiyall?sslmode=verify-full
# Applies database/roles/grants.sql after the migrations, as the same role: the privilege refresh for new tables and views.
MIGRATE_RUN_GRANTS=true
