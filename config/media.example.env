# Photo storage for local development: Cloudflare R2 (S3-compatible).
# Copy to config/media.local.env (git-ignored) and fill in the three blanks.
#
# Cloudflare dashboard > R2:
#   - Account ID: R2 overview page, right-hand side.
#   - Create an API token: "Manage R2 API tokens" > Create API token >
#     permission "Object Read & Write", limited to this one bucket.
#     It shows an Access Key ID and a Secret Access Key once; copy both here.
MEDIA_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
MEDIA_BUCKET=hiyall-media
MEDIA_ACCESS_KEY=
MEDIA_SECRET_KEY=
# R2 has a single region called "auto" and is always https.
MEDIA_REGION=auto
MEDIA_SECURE=true
