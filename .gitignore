.runtime/
.env
.env.*.local
*.log
*.pid
.DS_Store
node_modules/
dist/
coverage/
bin/
*.keystore
*.jks
android/local.properties
android/key.properties
**/.dart_tool/
**/build/
**/ios/Pods/
**/ios/.symlinks/

# Firebase project config written by scripts/firebase-setup.sh
config/firebase.local.json
apps/mobile/ios/Flutter/Firebase.xcconfig
.firebase/
config/media.local.env
config/chat-media.local.env
# FCM service account key (push notifications); see config/fcm-service-account.example.json
config/fcm-service-account.local.json
config/*service-account*.json
!config/*service-account*.example.json

# Filled-in container environment (infrastructure/docker/api.example.env is the template)
infrastructure/docker/*.env
!infrastructure/docker/*.example.env
# Per-environment release build inputs
config/mobile-release.*.local.env
# Production/staging API environment used by scripts/release-preflight.sh, and the key files it names under /secrets/
config/api.production.env
config/api.staging.env
config/secrets/

# Manual iOS signing settings written by scripts/build-release.sh in CI (Runner target only)
apps/mobile/ios/Flutter/Signing.xcconfig
# Production admin console environment, any local-only env file, and the R2 admin keys
config/admin.production.env
config/r2.local.env
config/*.local.env
*.env.local
# Python bytecode: the release preflight and its tests must leave nothing behind (gate a)
__pycache__/
scripts/__pycache__/
*.pyc
# Owner-role migration settings (config/migrate.*.example.env are the templates)
config/migrate.production.env
config/migrate.staging.env
